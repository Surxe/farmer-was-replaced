root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = tab
indent_size = 4
tab_width = 4

# Generated by the game - leave its formatting alone.
[src/__builtins__.py]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[*.json]
indent_style = unset
